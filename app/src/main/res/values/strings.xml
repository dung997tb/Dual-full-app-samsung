    <!-- Dialog hướng dẫn Shizuku -->
    <string name="guide_title">Hướng dẫn kết nối Shizuku</string>
    <string name="guide_sub">Thực hiện 1 lần duy nhất ngay trên máy</string>
    <string name="step1_title">Cài đặt ứng dụng Shizuku</string>
    <string name="step1_desc">Tải và cài đặt ứng dụng Shizuku miễn phí từ Google Play Store (hoặc GitHub) trên điện thoại của bạn.</string>
    <string name="step2_title">Bật Gỡ lỗi qua Wi-Fi (Wireless Debugging)</string>
    <string name="step2_desc">Vào Cài đặt điện thoại -&gt; Cài đặt cho người phát triển -&gt; Bật tính năng \u2018Gỡ lỗi qua Wi-Fi\u2019 (điện thoại cần kết nối Wi-Fi).</string>
    <string name="step3_title">Ghép nối mã 6 chữ số</string>
    <string name="step3_desc">Mở app Shizuku -&gt; Nhấn \u2018Ghép nối qua gỡ lỗi không dây\u2019 -&gt; Chọn \u2018Ghép nối thiết bị bằng mã ghép nối\u2019 và nhập mã 6 số do điện thoại cung cấp.</string>
    <string name="step4_title">Khởi chạy &amp; Cấp quyền cho AppClone</string>
    <string name="step4_desc">Quay lại Shizuku, bấm nút \u2018Bắt đầu\u2019 (Start). Sau đó vào mục \u2018Ủy quyền ứng dụng\u2019 và bật công tắc cho AppClone.</string>
